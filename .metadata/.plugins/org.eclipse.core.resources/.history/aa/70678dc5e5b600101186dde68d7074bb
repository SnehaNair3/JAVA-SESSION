package java_core.collections.set_interface.hashset;

import java.util.HashSet;
import java.util.Set;

public class BasicHashSet {
	public static void main(String[] args) {
		Set<String> fruits = new HashSet<String>();

		fruits.add("Banana");
		fruits.add("Apple");
		fruits.add("Mango");
		fruits.add("Plum");
		fruits.add("Plum");
		fruits.add("Fig");
	}
}
