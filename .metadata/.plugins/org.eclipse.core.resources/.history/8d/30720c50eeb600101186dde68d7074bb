package java_core.collections.set_interface.treeset;

import java.util.Iterator;
import java.util.TreeSet;

public class IteratingTreeSet {
	public static void main(String[] args) {

		TreeSet<String> planets = new TreeSet<String>(String.CASE_INSENSITIVE_ORDER);

		planets.add("Earth");
		planets.add("Mercury");
		planets.add("Venus");
		planets.add("Mars");
		planets.add("Jupiter");

		// enhanced for loop
		for (String s : planets) {
			System.out.println(s);
		}

		// iterator
		Iterator<String> it = planets.iterator();
		while (it.hasNext()) {
			System.out.println(it.next());
		}

		// forEach
		planets.forEach(planet -> System.out.println());

		// stream
		planets.stream().forEach(planet -> System.out.println());

	}
}
