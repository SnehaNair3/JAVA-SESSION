package java_core.java8_features.stream_api;

import java.util.Arrays;
import java.util.List;

//The map() function is used to transform each element in the stream
public class MapElements {
	public static void main(String[] args) {

		List<String> foods = Arrays.asList("Biriyani", "Pizza", "Burger", "Rice", "Pasta");

		// convert to upper case
		foods.stream().map(String::toUpperCase).forEach(System.out::println);
	}
}
