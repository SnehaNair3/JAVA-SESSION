package java_core.java8_features.optional_class;

import java.util.Optional;

public class Example1 {
	public static void main(String[] args) {
		Optional<String> gender = Optional.of("MALE");
		String answer1 = "Yes";
		String answer2 = null;

		System.out.println("Optional non-nullable " + gender);
		System.out.println("Optional non-nullable value : " + gender.get());
		System.out.println("Optional null : " + Optional.empty());

		System.out.println("Optional ofnullable : " + Optional.ofNullable(answer1));
		System.out.println("Optional ofnullable : " + Optional.ofNullable(answer2));

		System.out.println(" Optional of : " + Optional.of(answer2));

	}
}
